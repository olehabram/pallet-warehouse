<mxfile host="app.diagrams.net" type="device">
  <diagram id="pallet-warehouse-iterations" name="Три ітерації">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Pallet Warehouse: дорожня карта трьох ітерацій" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="20" width="860" height="65" />
        </mxCell>
        <mxCell id="i1" value="&lt;b&gt;Ітерація 1 · B-01–B-05&lt;/b&gt;&lt;br&gt;Основа застосунку та ролі&lt;br&gt;Картка, аналізи, бірка, правила готовності" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=20;spacing=14;fillColor=#EDF4F2;strokeColor=#126B70;fontColor=#132C3E;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="110" width="660" height="110" />
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;Перевірка й обговорення 1&lt;/b&gt;&lt;br&gt;Результат: підготовлена палета&lt;br&gt;Уточнення полів, одиниць і бірки" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=20;spacing=14;fillColor=#FFFFFF;strokeColor=#126B70;fontColor=#132C3E;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="250" width="660" height="90" />
        </mxCell>
        <mxCell id="i2" value="&lt;b&gt;Ітерація 2 · B-06–B-09&lt;/b&gt;&lt;br&gt;Приймання, місця, рух, видача&lt;br&gt;Переворот, пошук, залишки, історія" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=20;spacing=14;fillColor=#EDF4F2;strokeColor=#126B70;fontColor=#132C3E;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="370" width="660" height="110" />
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;Перевірка й обговорення 2&lt;/b&gt;&lt;br&gt;Результат: узгоджений складський рух&lt;br&gt;Уточнення адрес і операцій" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=20;spacing=14;fillColor=#FFFFFF;strokeColor=#126B70;fontColor=#132C3E;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="510" width="660" height="90" />
        </mxCell>
        <mxCell id="i3" value="&lt;b&gt;Ітерація 3 · B-10–B-14&lt;/b&gt;&lt;br&gt;Заявки, інтерфейс, підсумкові тести&lt;br&gt;Відновлення й документація" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=20;spacing=14;fillColor=#EDF4F2;strokeColor=#126B70;fontColor=#132C3E;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="630" width="660" height="110" />
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;Перевірка й обговорення 3&lt;/b&gt;&lt;br&gt;Результат: готовий навчальний продукт&lt;br&gt;Виправлення перед демонстрацією" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=20;spacing=14;fillColor=#FFFFFF;strokeColor=#126B70;fontColor=#132C3E;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="770" width="660" height="90" />
        </mxCell>
        <mxCell id="defense" value="&lt;b&gt;Захист усього проєкту&lt;/b&gt;&lt;br&gt;Початок грудня 2026 року&lt;br&gt;Точну дату не встановлено" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Times New Roman;fontSize=20;spacing=14;fillColor=#EDF4F2;strokeColor=#126B70;fontColor=#132C3E;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="900" width="660" height="100" />
