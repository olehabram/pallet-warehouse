<mxfile host="app.diagrams.net" type="device"><diagram id="warehouse-roadmap" name="Дорожня карта"><mxGraphModel dx="1800" dy="1080" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1080" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="Свісс Кроно — система обліку складських операцій" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=34;fontStyle=1;fontColor=#203549;" vertex="1" parent="1"><mxGeometry x="60" y="25" width="1680" height="55" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Три ітерації • запланована реалізація • цілі, результати та ризики" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=20;fontColor=#627588;" vertex="1" parent="1"><mxGeometry x="60" y="83" width="1680" height="30" as="geometry"/></mxCell>
<mxCell id="head0" value="Ітерація 1 · Підготовка палети" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#203549;" vertex="1" parent="1"><mxGeometry x="60" y="135" width="460" height="40" as="geometry"/></mxCell>
<mxCell id="goal0" value="Мета&#xa;Підготувати палету з аналізами&#xa;та актуальною фізичною біркою" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#203549;spacing=16;rounded=1;arcSize=16;fillColor=#EDF5FA;strokeColor=#7F9FB5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="460" height="125" as="geometry"/></mxCell>
<mxCell id="result0" value="Запланований результат · B-01–B-05&#xa;&#xa;Основа застосунку, БД і права трьох ролей&#xa;Картка та чернетка палети, готові аналізи&#xa;Друк і підтвердження бірки&#xa;Правила готовності з поясненнями&#xa;Збереження даних після перезапуску" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#203549;spacing=16;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6C87;strokeWidth=2;align=center;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="60" y="395" width="460" height="235" as="geometry"/></mxCell>
<mxCell id="risk0" value="Ризики&#xa;Неуточнені показники й нормативи&#xa;Застаріла бірка або помилкове підтвердження&#xa;Запізнілий вибір стеку; обхід прав" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#203549;spacing=16;shape=note;size=18;fillColor=#FFF7E7;strokeColor=#C4A66A;align=center;fontSize=21;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="460" height="155" as="geometry"/></mxCell>
<mxCell id="mitigate0" value="Погодити дані й стек; перевіряти права.&#xa;Після змін скидати підтвердження." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=19;fontColor=#76633E;" vertex="1" parent="1"><mxGeometry x="60" y="875" width="460" height="60" as="geometry"/></mxCell>
<mxCell id="down0" value="реалізація" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#496479;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#496479;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="goal0" target="result0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="riskedge0" value="врахувати ризики" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#496479;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#496479;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#AD8E50;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="risk0" target="result0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="head1" value="Ітерація 2 · Складський рух" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#203549;" vertex="1" parent="1"><mxGeometry x="670" y="135" width="460" height="40" as="geometry"/></mxCell>
<mxCell id="goal1" value="Мета&#xa;Відображати рух цілої палети,&#xa;актуальне місце, залишки й історію" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#203549;spacing=16;rounded=1;arcSize=16;fillColor=#EDF5FA;strokeColor=#7F9FB5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="670" y="200" width="460" height="125" as="geometry"/></mxCell>
<mxCell id="result1" value="Запланований результат · B-06–B-09&#xa;&#xa;Приймання, переміщення та видача&#xa;Тимчасова зона й пряма подача без стелажа&#xa;Облік перевороту «низу»&#xa;Пошук, залишки та історія&#xa;Безпечне вилучення помилкових чернеток" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#203549;spacing=16;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6C87;strokeWidth=2;align=center;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="670" y="395" width="460" height="235" as="geometry"/></mxCell>
<mxCell id="risk1" value="Ризики&#xa;Подвійне зайняття місця; частковий запис&#xa;Неясні адреси й вигадані правила перевороту&#xa;Втрата історії; помилки в залишках" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#203549;spacing=16;shape=note;size=18;fillColor=#FFF7E7;strokeColor=#C4A66A;align=center;fontSize=21;" vertex="1" parent="1"><mxGeometry x="670" y="710" width="460" height="155" as="geometry"/></mxCell>
<mxCell id="mitigate1" value="Транзакції, тести одночасних запитів.&#xa;Погодити адресацію; зберігати історію." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=19;fontColor=#76633E;" vertex="1" parent="1"><mxGeometry x="670" y="875" width="460" height="60" as="geometry"/></mxCell>
<mxCell id="down1" value="реалізація" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#496479;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#496479;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="goal1" target="result1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="riskedge1" value="врахувати ризики" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#496479;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#496479;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#AD8E50;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="risk1" target="result1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="next1" value="перевірка&#xa;й показ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#496479;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#496479;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="result0" target="result1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="head2" value="Ітерація 3 · Завершення продукту" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#203549;" vertex="1" parent="1"><mxGeometry x="1280" y="135" width="460" height="40" as="geometry"/></mxCell>
<mxCell id="goal2" value="Мета&#xa;Об’єднати роботу трьох ролей&#xa;та підтвердити готовність до демонстрації" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#203549;spacing=16;rounded=1;arcSize=16;fillColor=#EDF5FA;strokeColor=#7F9FB5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1280" y="200" width="460" height="125" as="geometry"/></mxCell>
<mxCell id="result2" value="Запланований результат · B-10–B-14&#xa;&#xa;Створення, скасування й виконання заявок&#xa;Завершений український інтерфейс&#xa;Підсумкові тести та перевірки NFR&#xa;Резервне копіювання й відновлення&#xa;Відтворюваний запуск і документація" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#203549;spacing=16;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3E6C87;strokeWidth=2;align=center;verticalAlign=middle;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1280" y="395" width="460" height="235" as="geometry"/></mxCell>
<mxCell id="risk2" value="Ризики&#xa;Дублі заявок та видачі; брак часу&#xa;Неперевірені цілі швидкодії й відновлення&#xa;Розбіжності документації та реалізації" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fontColor=#203549;spacing=16;shape=note;size=18;fillColor=#FFF7E7;strokeColor=#C4A66A;align=center;fontSize=21;" vertex="1" parent="1"><mxGeometry x="1280" y="710" width="460" height="155" as="geometry"/></mxCell>
<mxCell id="mitigate2" value="Резервування, тести й фактичні вимірювання.&#xa;Спочатку Must; звірити документи з кодом." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=19;fontColor=#76633E;" vertex="1" parent="1"><mxGeometry x="1280" y="875" width="460" height="60" as="geometry"/></mxCell>
<mxCell id="down2" value="реалізація" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#496479;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#496479;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="goal2" target="result2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="riskedge2" value="врахувати ризики" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#496479;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#496479;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#AD8E50;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="risk2" target="result2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="next2" value="перевірка&#xa;й показ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#496479;strokeWidth=2;fontFamily=Arial;fontSize=18;fontColor=#496479;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="result1" target="result2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="feedback" value="Кожна ітерація завершується перевіркою та демонстрацією. Зауваження → уточнення backlog → наступна ітерація." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=22;fontColor=#203549;" vertex="1" parent="1"><mxGeometry x="60" y="970" width="1680" height="34" as="geometry"/></mxCell>
<mxCell id="optional" value="B-15 (Should) і B-16 (Could) — необов’язкова частина ітерації 3 після Must. Орієнтир захисту: початок грудня 2026; точну дату не встановлено." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;strokeColor=none;fillColor=none;fontSize=18;fontColor=#627588;" vertex="1" parent="1"><mxGeometry x="60" y="1020" width="1680" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
